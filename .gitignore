.env
.cache
__pycache__/
*.pyc
*.pyo
.DS_Store
# data/* (not data/) so git still traverses in to check the exceptions below
# — a bare "data/" blocks negation of files inside it entirely.
data/*
# The two derived files output/ is built from, tracked so CI can rebuild
# output/ on every push to main without needing the raw scraped sources
# (which are gitignored and can take hours to re-scrape).
!data/scores.csv
!data/spotify_links.csv
venv/
.venv/
# Build dir is ignored except the published pages, which are deployed to joavn.dev/mpi,
# and the scored CSV, which is synced to Versed's server data dir
output/*
!output/index.html
!output/billboard.html
!output/music_index_full.csv
/.vscode
